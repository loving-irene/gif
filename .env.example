GIF_BASE_URL=http://127.0.0.1:8096
GIF_DATABASE_PATH=gif.db
# Generate with: openssl rand -hex 32
GIF_SECRET=
GIF_COOKIE_SECURE=false
# 仅信任本机反向代理的 X-Real-IP；Nginx 必须用 $remote_addr 覆盖此请求头。
GIF_TRUST_PROXY=true
# 开启脱敏的生图请求、轮询与网络诊断日志。
GIF_DEBUG=false
# Set a strong initial administrator password (at least 16 characters).
GIF_ADMIN_PASSWORD=
# Secrets can instead be set in the management console; never commit .env.
GEEKAI_API_KEY=
# Aliyun Direct Mail, China (Hangzhou). These can also be set in /who.
ALIYUN_DM_SENDER=
ALIYUN_DM_SMTP_PASSWORD=
